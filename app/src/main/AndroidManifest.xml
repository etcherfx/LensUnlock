<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the settings screen show the label and icon of the apps in scope. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ModuleApp"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:description="@string/module_description"
        android:label="@string/app_name"
        android:theme="@style/Theme.LensUnlock">

        <!-- Opened from the Xposed manager; there is no launcher icon. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>
    </application>
</manifest>
